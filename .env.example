# --- Database ---
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Shopify app OAuth (client ID en secret voor app-installatie/autorisatie) ---
# Deze worden gebruikt door /api/auth en /api/auth/callback.
SHOPIFY_CLIENT_ID=db247c0b3b7c65f9b5d8d798ae30b925
SHOPIFY_CLIENT_SECRET=shpss_xxx
# Backward-compatibiliteit: sommige bestaande modules lezen SHOPIFY_APP_CLIENT_SECRET.
# Zet deze op dezelfde waarde als SHOPIFY_CLIENT_SECRET.
SHOPIFY_APP_CLIENT_SECRET=shpss_xxx

# --- Shopify Admin API (same store as the storefront theme) ---
SHOPIFY_STORE_DOMAIN=ggh8q9-v1.myshopify.com
SHOPIFY_API_VERSION=2024-10
# SHOPIFY_ADMIN_ACCESS_TOKEN is no longer used. The Admin API token is
# obtained and auto-refreshed at runtime via Client Credentials Grant
# (SHOPIFY_CLIENT_ID/SHOPIFY_CLIENT_SECRET above) and cached in Postgres
# (shopify_admin_token table) — see lib/shopify/tokenService.ts. It never
# expires from the app's perspective; no manual token rotation needed.

# --- App / Vercel ---
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# Optioneel; VERPLICHT in productie. Beschermt /api/cron/* tegen onbevoegde
# aanroepen. Zonder deze variabele weigert de cron in productie te draaien.
CRON_SECRET=

# --- Marktplaats ---
# mock: no real API calls, everything else fully functional
# sandbox: only if Marktplaats confirms a sandbox exists for our credentials
# production: real, live advertisements
MARKTPLAATS_ENVIRONMENT=mock
MARKTPLAATS_CLIENT_ID=
MARKTPLAATS_CLIENT_SECRET=
MARKTPLAATS_REDIRECT_URI=https://your-app.vercel.app/api/marktplaats/oauth/callback

# --- Marktplaats browser-test (LOKAAL/DEV-ONLY — géén productiepad) ---
# Opent het échte Marktplaats-plaatsingsformulier via Playwright en vult de
# Shopify-gegevens in om de veldmapping te controleren, zolang er nog geen
# bruikbare officiële API-toegang is. Vervangt de officiële API niet
# (zie lib/marktplaats/apiPublisher.ts). NOOIT op Vercel/Coolify zetten —
# dit opent een zichtbaar browservenster op de machine die het draait.
# Zie MARKTPLAATS_INTEGRATION.md ("Test op Marktplaats").
MARKTPLAATS_BROWSER_TEST=true
# HARDE guard: false = er wordt NOOIT een advertentie geplaatst, ook niet als
# selectors of de flow veranderen. Laat op false tenzij je bewust wilt testen.
# true = de browsertest plaatst NA het invullen één echte testadvertentie
# (verwijder die daarna zelf uit Mijn Advertenties).
MARKTPLAATS_BROWSER_ALLOW_SUBMIT=false
# VERPLICHT om te kunnen plaatsen: verkoperspostcode die Marktplaats op elke
# advertentie zet (veld "Postcode (verplicht)" op het detailformulier).
# MARKTPLAATS_BROWSER_POSTCODE=1234 AB
# Plaatsingspagina (standaard https://www.marktplaats.nl/plaats).
# MARKTPLAATS_BROWSER_PLACEMENT_URL=https://www.marktplaats.nl/plaats
# Optioneel:
# MARKTPLAATS_BROWSER_HEADLESS=false
# MARKTPLAATS_BROWSER_CHANNEL=chrome
# MARKTPLAATS_BROWSER_LOGIN_TIMEOUT_MS=300000
# MARKTPLAATS_BROWSER_NAV_TIMEOUT_MS=30000
# MARKTPLAATS_BROWSER_MAX_IMAGES=10
# Persistente browserprofielen/sessies staan standaard in .playwright/
# (staat in .gitignore — NOOIT committen).
# MARKTPLAATS_BROWSER_PROFILE_DIR=.playwright/marktplaats-profile
# MARKTPLAATS_BROWSER_DEBUG_DIR=.playwright/debug

# --- Admin panel access ---
ADMIN_PANEL_PASSWORD=change-me

# --- AI product recognition (see AI_PRODUCT_RECOGNITION.md) ---
# Leave the active provider's API key empty to disable the feature (returns a clear 500, never a crash).
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional alternate/fallback providers — any of these left empty is simply
# skipped. If more than one is configured, the unused ones (in the order
# gemini -> groq -> openrouter) are tried automatically as a fallback chain
# when the primary provider fails (rate limit, overload, timeout, server
# error) — see lib/ai/fallbackVisionProvider.ts.
# AI_PROVIDER=groq — free/cheap, but its free tier's input-tokens-per-minute
# limit is easy to hit during normal testing.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# AI_PROVIDER=openrouter — extra free-tier fallback, useful when both Gemini
# and Groq are rate-limited/overloaded at the same time.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o

# --- Voorraadmeldingen / e-mail ---
# Publieke storefront-URL voor de CTA-link in de voorraadmelding-mail.
# Gebruik je eigen domein; valt terug op https://SHOPIFY_STORE_DOMAIN.
SHOPIFY_STOREFRONT_URL=https://www.iselectstore.nl
# E-mailprovider: "mock" (default, verstuurt niets), "resend" of "postmark".
# LET OP: in productie gooit mock een fout i.p.v. stilletjes niets te doen.
# Zet dus altijd EMAIL_PROVIDER=resend + RESEND_API_KEY + RESEND_FROM.
# Alleen voor bewuste tests in productie: ALLOW_MOCK_EMAIL=1
EMAIL_PROVIDER=mock
# ALLOW_MOCK_EMAIL=
# Resend (aanbevolen productieprovider):
RESEND_API_KEY=
RESEND_FROM=noreply@iselectstore.nl
# Postmark (alternatief):
POSTMARK_API_KEY=
POSTMARK_FROM=noreply@iselectstore.nl
# Shopify Email (alleen mock/test mode; echte verzending vereist extra setup):
SHOPIFY_EMAIL_SHOP_DOMAIN=ggh8q9-v1.myshopify.com
# Optionele rate limits voor POST /api/inventory/subscribe (per 15 minuten).
# INVENTORY_SUBSCRIBE_RATE_IP=20
# INVENTORY_SUBSCRIBE_RATE_EMAIL=10

# --- WhatsApp ---
WHATSAPP_NUMBER=31643295022
WHATSAPP_DEFAULT_MESSAGE=Hoi%20iSelectStore%2C%20ik%20heb%20een%20vraag.

# --- WebwinkelKeur ---
# Officiële WebwinkelKeur shop ID (alleen cijfers). Leeg = widget wordt niet getoond.
WEBWINKELKEUR_SHOP_ID=

# --- Marketing / tracking ---
# Meta Pixel ID (alleen cijfers). Wordt via Shopify Customer Events geladen, nooit hardcoded scripts.
META_PIXEL_ID=
# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
GOOGLE_ANALYTICS_ID=
# Google Ads conversion ID (AW-XXXXXXXXXX).
GOOGLE_ADS_ID=

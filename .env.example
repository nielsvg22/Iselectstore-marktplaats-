# --- Database ---
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Shopify Admin API (same store as the storefront theme) ---
SHOPIFY_STORE_DOMAIN=ggh8q9-v1.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2024-10

# --- Marktplaats ---
# mock: no real API calls, everything else fully functional
# sandbox: only if Marktplaats confirms a sandbox exists for our credentials
# production: real, live advertisements
MARKTPLAATS_ENVIRONMENT=mock
MARKTPLAATS_CLIENT_ID=
MARKTPLAATS_CLIENT_SECRET=
MARKTPLAATS_REDIRECT_URI=https://your-app.vercel.app/api/marktplaats/oauth/callback

# --- Admin panel access ---
ADMIN_PANEL_PASSWORD=change-me
